# Optional: used only when running the Node/Express web server (npm run dev / start).
# Not required for the Android APK — the app translates on-device via glossary,
# Google Translate, MyMemory, or a user-supplied API key.
GEMINI_API_KEY=""

# Optional: if you host the Express backend, set this before `npm run build`
# so the Android app can call /api/translate on your server.
# Example: https://your-translator-api.example.com
VITE_BACKEND_URL=""
